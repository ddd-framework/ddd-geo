{
    "name": "mgamadeus/ddd-common-geo",
    "description": "Addresses, geocoding, GeoRegions, GeoTypes for mgamadeus/ddd",
    "minimum-stability": "stable",
    "license": "MIT",
    "homepage": "https://github.com/ddd-framework/ddd-geo",
    "support": {
        "issues": "https://github.com/ddd-framework/ddd-geo/issues",
        "source": "https://github.com/ddd-framework/ddd-geo"
    },
    "version": "1.0.17",
    "authors": [
        {
            "name": "Marius-Eugen Gerdan",
            "email": "marius@gerdan.net"
        }
    ],
    "require": {
        "mgamadeus/ddd-common-political": "^1.0.15",
        "mgamadeus/ddd": "^2.70.7 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "DDD\\": "src/"
        }
    },
    "extra": {
        "ddd-module": "DDD\\Modules\\Geo\\GeoModule"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
